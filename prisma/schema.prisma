// Backend for the free RIASEC funnel (register -> OTP -> test -> results) and
// real checkout (Order model, below) via Razorpay. Deep-Dive module content
// itself stays mocked (lib/mockApi.ts) - only payment is real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  REGISTERED
  IN_PROGRESS
  COMPLETED
}

enum OtpPurpose {
  /** Verifying the mobile number entered during registration (tied to a session) */
  SESSION_VERIFY
  /** Signing in to view/resume existing wards (mobile-only, no session yet) */
  SIGN_IN
}

model Parent {
  id        String              @id @default(cuid())
  name      String
  mobile    String
  createdAt DateTime            @default(now())
  children  Child[]
  sessions  AssessmentSession[]

  @@index([mobile])
}

model Child {
  id       String              @id @default(cuid())
  parentId String
  parent   Parent              @relation(fields: [parentId], references: [id])
  name     String
  /** Matches lib/validation.ts's CLASS_OPTIONS, e.g. "Class 10", or "Other" */
  grade    String
  /** Only set when grade is "Other" - the class the parent actually typed */
  gradeOther String?
  sessions AssessmentSession[]
}

/** One registration + its RIASEC test progress. Mirrors types/index.ts's SessionState,
 *  scoped to only the fields this phase's funnel actually touches. */
model AssessmentSession {
  id                     String    @id @default(cuid())
  /** Matches SessionState.sessionToken, e.g. "dsh_XXXX" */
  token                  String    @unique
  parentId               String
  parent                 Parent    @relation(fields: [parentId], references: [id])
  childId                String
  child                  Child     @relation(fields: [childId], references: [id])
  consentGiven           Boolean   @default(false)
  /** When consent was given - null if consentGiven is false */
  consentedAt            DateTime?
  /** Which wording of the consent text was agreed to (lib/consent.ts's CONSENT_VERSION) */
  consentVersion         String?
  otpVerified            Boolean   @default(false)
  schoolCode             String?
  schoolId               String?
  classId                String?
  parentStatedPreference String?
  /** Record<number, number> - questionId -> chosen option (1 or 2) */
  responses              Json      @default("{}")
  /** Record<RiasecType, number> once scored */
  scores                 Json?
  /** School-pilot + Deep-Dive module answers, keyed by module name (e.g.
   *  "aptitude", "sjt") - Record<moduleName, Record<questionId, answer>>.
   *  Merged one level deep on PATCH, same spirit as `responses` above. */
  moduleResponses        Json      @default("{}")
  /** Record<moduleName, Record<traitKey, score>> */
  moduleScores           Json      @default("{}")
  /** REGISTERED -> IN_PROGRESS -> COMPLETED, advanced from PATCH /session/:token */
  status                 SessionStatus @default(REGISTERED)
  /** count of answered RIASEC questions out of TOTAL_QUESTIONS (36) */
  answeredCount          Int       @default(0)
  /** the highest RIASEC question id included in the most recent PATCH */
  lastQuestionId         Int?
  /** bumped on every PATCH - a session idle past 30 minutes reads as TIMED_OUT
   *  (derived at read time, never stored as its own status) */
  lastActivityAt         DateTime  @default(now())
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  /** One WhatsApp nudge per threshold, then stop - null until that
   *  threshold's reminder has actually been sent (lib/whatsapp/reminderSweep.ts) */
  reminder2hSentAt       DateTime?
  reminder24hSentAt      DateTime?
  reminder72hSentAt      DateTime?
  completedAt            DateTime?
  /** The highest tier actually paid for (lib/pricing.ts's TierLevel, 1-3) -
   *  set only from a verified Razorpay payment (server/routes/checkout.ts),
   *  never trusted from the client. This, not anything in sessionStorage, is
   *  what gates access to the Deep-Dive modules. */
  purchasedTierLevel     Int?
  /** This session's own invite code, generated on first OTP verify success
   *  (server/routes/otp.ts) - shared via lib/invite.ts's /register?ref= link.
   *  Null until otpVerified, since an unverified registration can't invite. */
  referralCode           String?   @unique
  /** The referralCode this session arrived with, if any (lib/utm.ts's
   *  ?ref= capture) - who gets credit if this parent verifies and counts. */
  referredByCode         String?
  /** Set once this session has been counted toward another session's invite
   *  total (server/routes/otp.ts) - makes the count idempotent across retries. */
  referralCountedAt      DateTime?
  /** How purchasedTierLevel came to be set: "PAYMENT" or "REFERRAL". Null
   *  until either happens. Drives lib/checkout/paidTierLevel.ts's distinction
   *  between "has this tier" and "paid for this tier". */
  unlockedVia            String?
  unlockedAt             DateTime?
  /** Set once all three Deep-Dive modules (lib/testModules.ts's
   *  DEEP_DIVE_MODULES) have scores in moduleScores. */
  deepDiveCompletedAt    DateTime?
  /** Consent for marketing-kind WhatsApp sends (lib/whatsapp/journey.ts) -
   *  separate from consentGiven, which is the assessment consent. */
  whatsappOptIn          Boolean   @default(false)
  /** Set from a "Stop promotions" reply (server/routes/whatsappWebhook.ts) -
   *  blocks marketing sends even if whatsappOptIn is true. */
  whatsappOptOutAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  otpCodes               OtpCode[]
  reportInterestLeads    ReportInterestLead[]
  orders                 Order[]
  whatsappMessages       WhatsAppMessage[]
  counsellorCalls        CounsellorCall[]

  @@index([token])
  @@index([referredByCode])
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
}

/** One Razorpay order per checkout attempt - a session can have several over
 *  time (e.g. buying the Detailed Report now, the Consultation add-on later).
 *  Created as soon as checkout starts (CREATED); only ever marked PAID from a
 *  verified payment signature or webhook, never from anything the browser
 *  alone claims. */
model Order {
  id                String      @id @default(cuid())
  sessionId         String
  session           AssessmentSession @relation(fields: [sessionId], references: [id])
  razorpayOrderId   String      @unique
  /** Set once a payment actually completes against this order */
  razorpayPaymentId String?
  /** In paise, matching Razorpay's own convention (e.g. ₹999 = 99900) */
  amount            Int
  currency          String      @default("INR")
  /** lib/pricing.ts's TierLevel (1-4) this order is for */
  tierLevel         Int
  status            OrderStatus @default(CREATED)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([sessionId])
}

/** A parent clicking "Know more" on a completed /results page - the free
 *  snapshot's only lead-capture point until real paid checkout exists. One
 *  row per click is fine (the frontend disables the button after success,
 *  so a duplicate here means two separate visits, not a double-click). */
model ReportInterestLead {
  id        String            @id @default(cuid())
  sessionId String
  session   AssessmentSession @relation(fields: [sessionId], references: [id])
  /** Which upsell tier they picked - matches lib/pricing.ts's TIER_OPTIONS[].level (1-3) */
  tierLevel Int?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([sessionId])
}

model OtpCode {
  id         String             @id @default(cuid())
  /** Null for a SIGN_IN-purpose code, which is tied to a mobile number only,
   *  not yet to any particular session. */
  sessionId  String?
  session    AssessmentSession? @relation(fields: [sessionId], references: [id])
  mobile     String
  purpose    OtpPurpose         @default(SESSION_VERIFY)
  /** Never store the plaintext code */
  codeHash   String
  expiresAt  DateTime
  attempts   Int                @default(0)
  consumedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([mobile, purpose, createdAt])
  @@index([sessionId])
}

/** A signed-in parent's bearer token (POST /auth/otp/verify), scoped to a
 *  mobile number rather than any single Parent row, since one real parent
 *  can have several Parent rows (Parent.mobile is not unique - see
 *  POST /register). Revoked on logout; also naturally expires. */
model AuthSession {
  id         String    @id @default(cuid())
  mobile     String
  /** Never store the plaintext token - see lib/auth/token.ts */
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([mobile])
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

/** One row per WhatsApp send attempt, written BEFORE the send is actually made
 *  (lib/whatsapp/journey.ts's "claim the send" pattern) - the unique
 *  constraint below is what makes a send idempotent, not application logic.
 *  `key` disambiguates repeatable templates (e.g. a reminder fired at both
 *  24h and 72h) - empty string for templates that only ever send once. */
model WhatsAppMessage {
  id            String                @id @default(cuid())
  sessionId     String
  session       AssessmentSession     @relation(fields: [sessionId], references: [id])
  /** Env-var-controlled template name, e.g. "report_offer" */
  template      String
  key           String                @default("")
  kind          String
  status        WhatsAppMessageStatus
  /** Meta's message id, once sent - matched back to the webhook's statuses[] */
  metaMessageId String?
  error         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([sessionId, template, key])
  @@index([metaMessageId])
}

enum CounsellorCallStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/** One 45-minute counsellor call for a Tier 4 ("Report + Counsellor") parent -
 *  booked/managed by the admin team (server/routes/admin.ts), not self-serve. */
model CounsellorCall {
  id          String               @id @default(cuid())
  sessionId   String
  session     AssessmentSession    @relation(fields: [sessionId], references: [id])
  scheduledAt DateTime
  status      CounsellorCallStatus @default(SCHEDULED)
  /** Required on booking (server/routes/admin.ts) - "" only for rows that
   *  pre-date this field. */
  meetingLink String               @default("")
  notes       String?
  /** Calendly's invitee URI (server/routes/calendlyWebhook.ts) - our key for
   *  matching reschedules/cancels back to this row. Null for admin-booked calls. */
  calendlyInviteeUri String?       @unique
  /** The scheduled event's URI - fetched again if the Meet link arrives late. */
  calendlyEventUri   String?
  /** Calendly's own reschedule page for this booking - omitted from GET
   *  /session for admin-booked calls, since they have none. */
  rescheduleUrl      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([sessionId])
}

/** One WhatsApp message in a conversation with a parent outside the template
 *  journey - something they sent us (IN: a reply to counsellor_confirmed, a
 *  question, STOP) or the team's answer from the /admin/inbox page (OUT).
 *  The Cloud API delivers replies only to server/routes/whatsappWebhook.ts,
 *  so this table is the only place anyone sees them. Per mobile number, not
 *  per session - a parent can have more than one child registered. */
model WhatsAppChatMessage {
  id            String    @id @default(cuid())
  /** The parent's 10-digit mobile (lib/validation.ts's normalizeMobile) */
  mobile        String
  /** "IN" (from the parent) or "OUT" (the team's reply) */
  direction     String
  text          String
  /** Meta's message id - unique, so a webhook delivered twice is stored once */
  metaMessageId String?   @unique
  /** IN only: when the team dealt with it (replied, or marked it done) */
  handledAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([mobile, createdAt])
}
