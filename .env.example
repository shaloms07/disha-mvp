# Copy to .env for local dev (matches docker-compose.yml's local Postgres).
DATABASE_URL="postgresql://disha:disha_dev_only@localhost:5432/disha_dev"

# "stub" logs the OTP code to the server console instead of sending a real SMS -
# use this for all local/dev work. Switch to "smsgw" only in production once
# DLT registration (pe_id/template_id) is approved and the vars below are set.
OTP_PROVIDER="stub"

# web.smsgw.in - HTTP(S)/XML/JSON API. See server/routes/otp.ts / lib/sms/otpProvider.ts.
SMSGW_USERNAME=""
SMSGW_PASSWORD=""
SMSGW_SENDER_ID=""
# DLT entity id (registered with the telecom operator)
SMSGW_PE_ID="1601653164084037292"
# DLT-approved template id for the OTP message
SMSGW_TEMPLATE_ID="1077354980008656385"
# Must match the DLT-approved template's exact wording. Paste it verbatim -
# {#numeric#} (or {otp}/{code}) is replaced by the code. Defaults to this same text if unset.
SMSGW_OTP_TEMPLATE="Your OTP for account verification on MyLifeCoach is {#numeric#}. Please do not share this OTP with anyone. Thank you, Team SIMIPL."

# Used as the OTP hash pepper (lib/otp.ts) - change this for real deployments.
OTP_HASH_SECRET="dev-only-change-me"

# --- standalone server (server/) - runs separately from the Next.js app ---
PORT=4000
# Comma-separated list of origins allowed to call this API. Any https://*.vercel.app
# preview URL is allowed automatically (see server/index.ts) - list only the
# fixed production domain(s) and local dev here.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Next.js app - where it finds the standalone server ---
# Local dev: http://localhost:4000. Production (Vercel): https://api.mylifecoach.in
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
