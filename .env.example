# Copy to .env for local dev (matches docker-compose.yml's local Postgres).
DATABASE_URL="postgresql://disha:disha_dev_only@localhost:5432/disha_dev"

# "stub" logs the OTP code to the server console instead of sending a real SMS -
# use this for all local/dev work. Switch to "smsgw" only in production once
# DLT registration (pe_id/template_id) is approved and the vars below are set.
OTP_PROVIDER="stub"

# web.smsgw.in - HTTP(S)/XML/JSON API. See server/routes/otp.ts / lib/sms/otpProvider.ts.
SMSGW_USERNAME=""
SMSGW_PASSWORD=""
SMSGW_SENDER_ID=""
# DLT entity id (registered with the telecom operator)
SMSGW_PE_ID="1601653164084037292"
# DLT-approved template id for the OTP message
SMSGW_TEMPLATE_ID="1077354980008656385"
# Must match the DLT-approved template's exact wording. Paste it verbatim -
# {#numeric#} (or {otp}/{code}) is replaced by the code. Defaults to this same text if unset.
SMSGW_OTP_TEMPLATE="Your OTP for account verification on MyLifeCoach is {#numeric#}. Please do not share this OTP with anyone. Thank you, Team SIMIPL."

# Used as the OTP hash pepper (lib/otp.ts) - change this for real deployments.
OTP_HASH_SECRET="dev-only-change-me"

# "stub" logs to the server console instead of calling Meta - use this for all
# local/dev work. Switch to "meta" only in production, once the vars below are
# set. See lib/whatsapp/provider.ts.
WHATSAPP_PROVIDER="stub"

# WhatsApp Cloud API (graph.facebook.com) - see lib/whatsapp/provider.ts.
WHATSAPP_PHONE_NUMBER_ID=""
# Permanent System User token (whatsapp_business_messaging), not the 24h quickstart token.
WHATSAPP_ACCESS_TOKEN=""
# Exact approved template names from WhatsApp Manager - see lib/whatsapp/messages.ts.
WHATSAPP_EXAM_LINK_TEMPLATE="exam_link"
# Sent by server/jobs/reminderSweep.ts for an idle, unfinished session.
WHATSAPP_REMINDER_TEMPLATE="exam_reminder"

# Verify token for the GET handshake Meta sends when saving the webhook config
# (server/routes/whatsappWebhook.ts) - any string you choose, pasted into both
# places. Separate from WHATSAPP_APP_SECRET below, which verifies POST payloads.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta app secret (App Dashboard -> Settings -> Basic) - verifies the
# X-Hub-Signature-256 header on incoming webhook POSTs.
WHATSAPP_APP_SECRET=""

# New journey templates (lib/whatsapp/journeyMessages.ts) - each one stays
# OFF (every matching send is skipped and logged) until its approved template
# name is pasted in here. See server/API.md for what each template needs.
WHATSAPP_RESULT_LINK_TEMPLATE=""
WHATSAPP_REPORT_PAID_TEMPLATE=""
WHATSAPP_PAYMENT_RECEIVED_TEMPLATE=""
WHATSAPP_REFERRAL_PROGRESS_TEMPLATE=""
WHATSAPP_REFERRAL_UNLOCKED_TEMPLATE=""
WHATSAPP_FULL_REPORT_READY_TEMPLATE=""
WHATSAPP_COUNSELLOR_BOOK_TEMPLATE=""
WHATSAPP_COUNSELLOR_CONFIRMED_TEMPLATE=""
WHATSAPP_REPORT_OFFER_TEMPLATE=""
WHATSAPP_UPGRADE_OFFER_TEMPLATE=""
WHATSAPP_DEEPDIVE_REMINDER_TEMPLATE=""
WHATSAPP_COUNSELLOR_OFFER_TEMPLATE=""
WHATSAPP_COUNSELLOR_REMINDER_TEMPLATE=""
# Deep-Dive finished without a plan that includes its report (it's free to take)
WHATSAPP_DEEPDIVE_UNLOCK_TEMPLATE=""

# "Invite 3 parents, get the Career Match Report free" (lib/referral.ts) -
# switched off for now in favour of the ₹49 launch price. Set to "true" to
# turn invite-crediting back on (server/routes/otp.ts) - everything else
# about the feature (referral codes, the DB fields) stays on regardless.
REFERRALS_ENABLED=""

# Used to build the exam link sent over WhatsApp (lib/whatsapp/messages.ts).
# Production: https://www.mylifecoach.in
FRONTEND_BASE_URL="http://localhost:3000"

# Meta Pixel + Conversions API (ad-funnel tracking only - never fires on a
# child's own test/results pages, and never carries a child's name, answers,
# or scores). The Pixel ID is not secret (it ships in the page source
# either way); the access token is. See lib/meta/pixel.ts, lib/meta/capi.ts.
NEXT_PUBLIC_META_PIXEL_ID=""
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""

# Real checkout (Razorpay) - replaces lib/mockApi.ts's mockCheckout. Key ID is
# not secret (returned to the browser per-order, see server/routes/checkout.ts)
# but kept server-side anyway since it's never needed ahead of time by the
# frontend. Key Secret and Webhook Secret must never reach the browser.
# Use Test Mode keys here (Razorpay Dashboard -> Settings -> API Keys) until
# KYC/Live Mode is ready - Test Mode works immediately, no real money moves.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard -> Settings -> Webhooks -> the secret set when creating
# the webhook pointed at https://api.mylifecoach.in/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=""

# Internal /admin dashboard - a single operator, not a real user table. See
# lib/auth/admin.ts. ADMIN_PASSWORD_HASH is sha256(plaintext password), never
# the plaintext itself. ADMIN_SESSION_SECRET signs the login session token -
# change it per deployment.
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Report + Counsellor parents booking their own call (Calendly, see
# server/routes/calendlyWebhook.ts). Both empty: the feature is off - no
# webhook route is registered, and booking stays admin-page-only.
# Integrations -> API & webhooks on the Calendly account.
CALENDLY_API_TOKEN=""
# Random secret used both when creating the webhook subscription
# (npm run calendly:subscribe) and to verify every webhook delivery -
# generate with: openssl rand -hex 32
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Internal QA testers' mobile numbers (comma-separated, 10 digits) - these
# skip Razorpay entirely and are marked paid immediately (server/routes/checkout.ts),
# even once real (non-test-mode) Razorpay keys are live. Empty: no bypass for anyone.
CHECKOUT_BYPASS_MOBILES=""

# --- standalone server (server/) - runs separately from the Next.js app ---
PORT=4000
# Comma-separated list of origins allowed to call this API. Any https://*.vercel.app
# preview URL is allowed automatically (see server/index.ts) - list only the
# fixed production domain(s) and local dev here.
ALLOWED_ORIGINS="http://localhost:3000"

# --- Next.js app - where it finds the standalone server ---
# Local dev: http://localhost:4000. Production (Vercel): https://api.mylifecoach.in
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# The Calendly event parents book their counsellor call from (Report +
# Counsellor plan), e.g. https://calendly.com/<your-link>/counsellor-call.
# Empty: no calendar - the team books calls from the admin page.
NEXT_PUBLIC_CALENDLY_URL=""
